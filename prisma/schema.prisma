generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GarmentType {
  JACKET
  TROUSERS
  SKIRT
  WAISTCOAT
  THREE_QUARTER_COAT
  FULL_LENGTH_COAT
}

enum PreConsultationStatus {
  DRAFT
  SENT_TO_CUSTOMER
  COMPLETED
}

enum OrderStatus {
  CONSULTATION_BOOKED
  DEPOSIT_TAKEN
  BRIEF_SENT_TO_TAILOR
  IN_PRODUCTION
  FITTING_SCHEDULED
  COMPLETE
  DELIVERED
}

enum VentStyle {
  SINGLE
  DOUBLE
  NONE
}

enum AppointmentType {
  PRE_CONSULTATION_CALL
  IN_STORE_CONSULTATION
  FITTING
  COLLECTION
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReminderType {
  FOLLOW_UP_WITH_CUSTOMER
  CHASE_ANTHONY
  FITTING_TO_BOOK
  BALANCE_PAYMENT_DUE
  ORDER_READY_TO_COLLECT
  CUSTOM
}

model Customer {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  firstName      String
  lastName       String
  email          String?
  phone          String?
  address        String?
  notes          String?
  hasBlock       Boolean   @default(false)
  blockCreatedAt DateTime?

  measurements     Measurements?
  orders           OrderForm[]
  preConsultations PreConsultationForm[]
  appointments     Appointment[]
  reminders        Reminder[]

  @@index([lastName])
}

model Measurements {
  id         String   @id @default(cuid())
  updatedAt  DateTime @updatedAt
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  height               Decimal? @db.Decimal(6, 2)
  weight               Decimal? @db.Decimal(6, 2)
  neck                 Decimal? @db.Decimal(6, 2)
  chest                Decimal? @db.Decimal(6, 2)
  underChest           Decimal? @db.Decimal(6, 2)
  waist                Decimal? @db.Decimal(6, 2)
  highHip              Decimal? @db.Decimal(6, 2)
  hip                  Decimal? @db.Decimal(6, 2)
  shoulderWidth        Decimal? @db.Decimal(6, 2)
  shoulderToWaist      Decimal? @db.Decimal(6, 2)
  shoulderToHip        Decimal? @db.Decimal(6, 2)
  shoulderToKnee       Decimal? @db.Decimal(6, 2)
  shoulderToFloor      Decimal? @db.Decimal(6, 2)
  backLength           Decimal? @db.Decimal(6, 2)
  sleeveLength         Decimal? @db.Decimal(6, 2)
  sleeveWidth          Decimal? @db.Decimal(6, 2)
  wristWidth           Decimal? @db.Decimal(6, 2)
  frontChestWidth      Decimal? @db.Decimal(6, 2)
  backChestWidth       Decimal? @db.Decimal(6, 2)
  napeToWaist          Decimal? @db.Decimal(6, 2)
  waistToHip           Decimal? @db.Decimal(6, 2)
  waistToKnee          Decimal? @db.Decimal(6, 2)
  waistToFloor         Decimal? @db.Decimal(6, 2)
  thigh                Decimal? @db.Decimal(6, 2)
  knee                 Decimal? @db.Decimal(6, 2)
  calf                 Decimal? @db.Decimal(6, 2)
  ankle                Decimal? @db.Decimal(6, 2)
  inseam               Decimal? @db.Decimal(6, 2)
  outseam              Decimal? @db.Decimal(6, 2)
  rise                 Decimal? @db.Decimal(6, 2)
  trouserWidth         Decimal? @db.Decimal(6, 2)
  skirtLength          Decimal? @db.Decimal(6, 2)
  bustPointToBustPoint Decimal? @db.Decimal(6, 2)
  shoulderToBust       Decimal? @db.Decimal(6, 2)
  underarm             Decimal? @db.Decimal(6, 2)
  armhole              Decimal? @db.Decimal(6, 2)
  necklineDepth        Decimal? @db.Decimal(6, 2)
}

model PreConsultationForm {
  id                String                @id @default(cuid())
  createdAt         DateTime              @default(now())
  customerId        String
  customer          Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  completedBy       String                @default("Carla")
  occasionOrPurpose String?
  garmentType       GarmentType?
  stylePreferences  String?
  fabricPreferences String?
  inspirationNotes  String?
  budgetRange       String?
  existingFitIssues String?
  additionalNotes   String?
  status            PreConsultationStatus @default(DRAFT)

  orders OrderForm[]

  @@index([customerId])
  @@index([status])
}

// One order can contain multiple garments (OrderItems)
model OrderForm {
  id                String      @id @default(cuid())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  preConsultationId String?
  preConsultation   PreConsultationForm? @relation(fields: [preConsultationId], references: [id])
  conductedBy       String      @default("Carla")
  appointmentDate   DateTime?

  // Summary garment type (derived from first item — for list views)
  garmentType       GarmentType?

  // Block fee at order level (£350 on first-ever order, £0 if hasBlock)
  blockFee          Decimal?    @db.Decimal(10, 2)

  // Totals (summed from all items + block fee)
  subtotalExVat     Decimal?    @db.Decimal(10, 2)
  vatAmount         Decimal?    @db.Decimal(10, 2)
  totalIncVat       Decimal?    @db.Decimal(10, 2)
  depositRequired   Decimal?    @db.Decimal(10, 2)
  depositPaid       Decimal?    @db.Decimal(10, 2)
  depositPaidDate   DateTime?
  balancePaidDate   DateTime?
  fullyPaid         Boolean     @default(false)

  // Status & Timeline
  status                  OrderStatus @default(CONSULTATION_BOOKED)
  estimatedCompletionDate DateTime?
  briefSentAt             DateTime?
  fittingDate             DateTime?
  completedAt             DateTime?
  deliveredAt             DateTime?
  internalNotes           String?

  items        OrderItem[]
  appointments Appointment[]
  reminders    Reminder[]

  @@index([customerId])
  @@index([status])
}

// One garment within an order
model OrderItem {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  sortOrder   Int         @default(0)
  orderFormId String
  orderForm   OrderForm   @relation(fields: [orderFormId], references: [id], onDelete: Cascade)

  garmentType    GarmentType
  fabricPattern  String      @default("plain") // "plain" | "check"

  // Fabric
  fabricDescription   String?
  fabricCode          String?
  fabricColour        String?
  fabricPricePerMetre Decimal?  @db.Decimal(10, 2)
  fabricMeterage      Decimal?  @db.Decimal(8, 2)

  // Construction
  lining                      Boolean    @default(false)
  liningColour                String?
  liningDescription           String?
  buttons                     String?
  buttonCount                 Int?
  pockets                     String?
  lapelStyle                  String?
  ventStyle                   VentStyle?
  sleeveButtons               Int?
  waistbandStyle              String?
  hemStyle                    String?
  additionalConstructionNotes String?

  // Measurements specific to this garment (JSON: { "chest": "38.5", "waist": "30", ... })
  // Pre-filled from customer's stored measurements; editable per order
  measurements     Json?
  measurementNotes String?

  // Images
  sketchUrl            String?
  inspirationImageUrls Json?
  fabricSwatchUrl      String?

  // Pricing (ex-VAT)
  makingRate    Decimal?  @db.Decimal(10, 2)
  itemSubtotal  Decimal?  @db.Decimal(10, 2) // makingRate + fabricCost

  @@index([orderFormId])
}

model Appointment {
  id              String            @id @default(cuid())
  createdAt       DateTime          @default(now())
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderFormId     String?
  orderForm       OrderForm?        @relation(fields: [orderFormId], references: [id])
  appointmentDate DateTime
  appointmentType AppointmentType
  location        String            @default("19 Great Queen Street, London WC2B")
  conductedBy     String            @default("Carla")
  notes           String?
  reminderSent    Boolean           @default(false)
  status          AppointmentStatus @default(SCHEDULED)

  @@index([customerId])
  @@index([appointmentDate])
}

model Reminder {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderFormId String?
  orderForm   OrderForm?   @relation(fields: [orderFormId], references: [id])
  dueDate     DateTime
  type        ReminderType
  description String?
  completed   Boolean      @default(false)
  completedAt DateTime?

  @@index([dueDate])
  @@index([completed])
}
