# PostgreSQL connection string
# Local example:  postgresql://postgres:postgres@localhost:5432/demo_crm
# Railway will inject this automatically when you attach a Postgres plugin.
DATABASE_URL="postgresql://user:password@host:5432/demo_crm"

# Outlook SMTP (via Nodemailer) — used for transactional emails
GMAIL_USER=your_outlook_email@outlook.com
GMAIL_PASS=your_outlook_password_or_app_password

# Optional: shared secret used to authorize calls to /api/cron/* endpoints
CRON_SECRET=your_cron_secret_here
